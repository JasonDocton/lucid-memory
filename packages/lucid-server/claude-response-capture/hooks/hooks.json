{
	"hooks": {
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun",
						"args": [
							"run",
							"--cwd",
							"${CLAUDE_PLUGIN_ROOT}",
							"--no-env-file",
							"--no-install",
							"${CLAUDE_PLUGIN_ROOT}/capture.ts"
						],
						"timeout": 10
					}
				]
			}
		]
	}
}
