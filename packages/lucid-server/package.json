{
	"name": "lucid-server",
	"private": true,
	"version": "0.6.5",
	"lucidRelease": "0.6.6",
	"description": "MCP server for Lucid Memory - AI coding assistants that actually remember",
	"type": "module",
	"main": "src/index.ts",
	"bin": {
		"lucid-server": "./src/server.ts",
		"lucid": "./src/cli.ts"
	},
	"scripts": {
		"start": "bun run src/server.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"postinstall": "bun run --no-env-file --no-install scripts/legacy-update.ts"
	},
	"dependencies": {
		"@lucid-memory/native": "file:../native",
		"@lucid-memory/perception": "file:../perception",
		"@modelcontextprotocol/sdk": "^1.0.0",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.0.0"
	},
	"keywords": ["mcp", "claude", "memory", "sqlite", "ai"],
	"license": "GPL-3.0"
}
